{
  "expo": {
    "name": "LakayGoPay",
    "slug": "lakaygopay",
    "scheme": "lakaygopay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.milleclat.lakaygopay"
    },
    "android": {
      "package": "com.milleclat.lakaygopay"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "${EXPO_PROJECT_ID}"
      }
    }
  }
}
